# Copy to .env and fill in real values before running scripts/deploy.sh.

# --- Domains ---
# DOMAIN is the public invitation site (guest-facing, e.g. /{slug} links).
# API_DOMAIN is the backend API the Mini App calls directly from Telegram.
# MINIAPP_DOMAIN is the Builder Mini App's own URL (must be HTTPS — Telegram
# requires it for web_app buttons; nginx-proxy + letsencrypt-companion give
# you that automatically once DNS points here).
# All three need an A record pointing at this server's IP.
DOMAIN=xamidullayevi.uz
API_DOMAIN=api.xamidullayevi.uz
MINIAPP_DOMAIN=app.xamidullayevi.uz

SSL_EMAIL=admin@example.com

# From @BotFather
TELEGRAM_BOT_TOKEN=replace-with-a-real-bot-token-from-BotFather

# The bot's @username (without the @) — used for the "Open the bot" link
# on the public site's landing page ("/").
TELEGRAM_BOT_USERNAME=replace-with-your-bot-username
