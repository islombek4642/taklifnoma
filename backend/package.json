    "@prisma/client": "^5.19.1",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
