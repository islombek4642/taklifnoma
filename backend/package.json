{
  "name": "taklifnoma-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/presentation/server.ts",
    "build": "tsc -p tsconfig.json && cp -r content-seed dist/content-seed",
